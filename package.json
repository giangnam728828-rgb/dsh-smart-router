{
  "name": "dsh-smart-router",
  "version": "0.4.0",
  "description": "Model-led routing for DeepSeek Harness: every turn it puts the relevant skill and plugin capabilities in front of the model and states the decision rules, then leaves the decision to the model. Zero dependencies, zero model download.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "skill",
    "router",
    "agent",
    "cordis"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "optional": [
      "ctx.skills",
      "ctx.tools"
    ],
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": false
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
